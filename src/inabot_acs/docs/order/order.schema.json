{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/vda5050/order.schema.json",
  "title": "VDA5050 Order",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/Header"
    }
  ],
  "properties": {
    "orderId": {
      "$ref": "common.schema.json#/$defs/IDString"
    },
    "orderUpdateId": {
      "type": "integer",
      "minimum": 0
    },
    "zoneSetId": {
      "$ref": "common.schema.json#/$defs/IDString"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/Node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Edge"
      }
    }
  },
  "required": [
    "headerId",
    "timestamp",
    "version",
    "manufacturer",
    "serialNumber",
    "orderId",
    "orderUpdateId",
    "nodes"
  ],
  "additionalProperties": true,
  "description": "Note: constraint edges == nodes-1 must be validated in integration logic."
}