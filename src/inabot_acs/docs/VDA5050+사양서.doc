    <td class=3D"confluenceTd">Y</td>
    <td class=3D"confluenceTd">Serial number of the AGV</td>
   </tr>
   <tr class=3D"">
    <td class=3D"confluenceTd">orderId</td>
    <td class=3D"confluenceTd"><br></td>
    <td class=3D"confluenceTd">string</td>
    <td class=3D"confluenceTd">Y</td>
    <td class=3D"confluenceTd">Order identification.<br>
      This is to be used to identify multiple order messages that belong to=
 the same order.</td>
   </tr>
   <tr class=3D"">
    <td class=3D"confluenceTd">orderUpdateId</td>
    <td class=3D"confluenceTd"><br></td>
    <td class=3D"confluenceTd">uint32</td>
    <td class=3D"confluenceTd">Y</td>
    <td class=3D"confluenceTd">Order update identification.<br>
      Is unique per orderId.<br>
      If an order update is rejected, this field is to be passed in the rej=
ection message.</td>
   </tr>
   <tr class=3D"">
    <td class=3D"confluenceTd"><span style=3D"color:#c9372c;"><em>zoneSetId=
</em></span></td>
