    <td class=3D"confluenceTd">Serial number of the AGV.</td>
   </tr>
   <tr class=3D"">
    <td class=3D"confluenceTd">actions [action]</td>
    <td class=3D"confluenceTd">array</td>
    <td class=3D"confluenceTd">Array of actions that need to be performed i=
mmediately and are not part of the regular order.</td>
   </tr>
  </tbody>
 </table>
