{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/vda5050/instantActions.schema.json",
  "title": "VDA5050 InstantActions",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/Header"
    }
  ],
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/Action"
      }
    }
  },
  "required": [
    "headerId",
    "timestamp",
    "version",
    "manufacturer",
    "serialNumber",
    "actions"
  ],
  "additionalProperties": true
}